<h3><%= @plan.capitalize %> Subscription Plan</h3>
<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th>Unique ID</th>
      <th>From State</th>
      <th>To State</th>
      <th>Price (₹)</th>
      <th>Trips</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% @plan_data.each do |plan| %>
      <tr>
        <td><%= plan[:unique_id] %></td>
        <td><%= plan[:from_state] %></td>
        <td><%= plan[:to_state] %></td>
        <td><%= plan[:price] %></td>
        <td><%= plan[:trips] %></td>
        <td>
          <%= link_to 'Subscribe Now', new_customer_detail_path(plan: @plan, price: plan[:price]), class: 'btn btn-success' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
