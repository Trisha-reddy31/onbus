<h3>Enter Your Details</h3>
<%= form_with model: @customer, local: true do |f| %>
  <%= f.hidden_field :plan, value: @subscription_plan %>
  <%= f.hidden_field :price, value: @subscription_price %>

  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= f.label :gender %>
    <%= f.select :gender, ['Male', 'Female', 'Other'], {}, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= f.label :age %>
    <%= f.number_field :age, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= f.label :contact %>
    <%= f.text_field :contact, class: 'form-control' %>
  </div>

  <%= f.submit 'Proceed to Pay', class: 'btn btn-success' %>
<% end %>
