<div class="container mt-5 text-center">
  <h2>🚍 Start Your Journey</h2>
  <p>Your Plan ID: <strong><%= @plan_id %></strong></p>

  <p>Select your next step:</p>

  <div class="row justify-content-center mt-4">
    <% @buses.each do |bus| %>
      <div class="col-md-4 mb-3">
        <div class="card p-3 shadow-sm">
          <h4><%= bus[:name] %></h4>
          <p>Seat Price: <%= bus[:seat_price] %></p>
          <%= button_to "Book", book_bus_path, method: :post, params: { bus_name: bus[:name], fare: bus[:seat_price], plan_id: @plan_id }, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success mt-4"><%= flash[:notice] %></div>
  <% elsif flash[:alert] %>
    <div class="alert alert-danger mt-4"><%= flash[:alert] %></div>
  <% end %>
</div>