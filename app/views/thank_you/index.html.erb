<% if @subscription.present? %>
  <h2>🎉 Subscription Successful!</h2>
  <p><strong>Plan:</strong> <%= @plan_param.capitalize %></p>
  <p><strong>Route:</strong> <%= @subscription[:from_state] %> to <%= @subscription[:to_state] %></p>
  <p><strong>Trips:</strong> <%= @subscription[:trips] %></p>
  <p><strong>Price:</strong> ₹<%= @subscription[:price] %></p>
  <p><strong>Valid From:</strong> <%= @start_date.strftime('%B %d, %Y') %></p>
  <p><strong>Valid Till:</strong> <%= @expiry_date.strftime('%B %d, %Y') %></p>

<%= link_to "Start Your Journey", start_journeys_path(plan_id: @plan_id), class: "btn btn-primary mt-4" %>
<% else %>
  <p class="text-danger">No matching subscription found for this route and plan.</p>
<% end %>